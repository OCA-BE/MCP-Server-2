<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS LaunchAgent for the ABAP Config MCP server.

  Install:
    1. Edit the two absolute paths below (node binary + repo) to match your machine.
       Find node with:  which node
    2. cp deploy/com.abap-config-mcp.server.plist ~/Library/LaunchAgents/
    3. launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.abap-config-mcp.server.plist
    4. launchctl enable gui/$(id -u)/com.abap-config-mcp.server

  WorkingDirectory MUST be the repo root: connections.json and the engine ABAP
  (src/abap/*.abap) are both resolved relative to the process working directory.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.abap-config-mcp.server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/Users/geertsteyaert/github/abap-config-mcp/dist/index.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/geertsteyaert/github/abap-config-mcp</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart the HTTP server if it exits. launchd throttles relaunches to a
         10 s minimum, so a bad-config crash loop stays tame. -->
    <key>KeepAlive</key>
    <true/>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Users/geertsteyaert/Library/Logs/abap-config-mcp.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/geertsteyaert/Library/Logs/abap-config-mcp.log</string>
</dict>
</plist>
